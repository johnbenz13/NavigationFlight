diff --git a/NavigationFlight/Features/Cockpit/RouteAmendmentCompass.swift b/NavigationFlight/Features/Cockpit/RouteAmendmentCompass.swift
new file mode 100644
index 0000000..98bab85
--- /dev/null
+++ b/NavigationFlight/Features/Cockpit/RouteAmendmentCompass.swift
@@ -0,0 +1,163 @@
+import SwiftUI
+
+/// Owns touch presentation only. Magnetic values remain in the directed-leg entry.
+struct RouteAmendmentCompass: View {
+    let heading: Int?
+    let onSelection: (Int) -> Void
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @Environment(\.dynamicTypeSize) private var dynamicTypeSize
+    @ScaledMetric(relativeTo: .largeTitle) private var compassHeight = 176
+    @State private var motion = RouteAmendmentHeadingMotion()
+    @State private var isDragging = false
+    @State private var coast: Task<Void, Never>?
+    @State private var isCoasting = false
+
+    var body: some View {
+        GeometryReader { geometry in
+            let height = geometry.size.height
+            let radius = min(geometry.size.width / 2 - 24, height - 12)
+            let center = CGPoint(x: geometry.size.width / 2, y: height - 6)
+            let degrees = isDragging || isCoasting ? motion.degrees : Double(heading ?? 360)
+            ZStack(alignment: .top) {
+                Canvas { context, _ in
+                    for tick in 0..<360 {
+                        var angle = (Double(tick) - degrees).truncatingRemainder(dividingBy: 360)
+                        if angle > 180 { angle -= 360 }
+                        if angle < -180 { angle += 360 }
+                        guard abs(angle) <= 90 else { continue }
+                        let radians = angle * .pi / 180
+                        let major = tick % 10 == 0
+                        let length: CGFloat = tick % 30 == 0 ? 14 : major ? 9 : 4
+                        let outer = point(center, radius: radius, angle: radians)
+                        let inner = point(center, radius: radius - length, angle: radians)
+                        var path = Path()
+                        path.move(to: outer)
+                        path.addLine(to: inner)
+                        context.stroke(path, with: .color(.secondary.opacity(major ? 0.8 : 0.5)), lineWidth: major ? 1 : 0.5)
+                        if tick % (dynamicTypeSize.isAccessibilitySize ? 90 : 30) == 0 {
+                            let label = tick == 0 ? "N" : tick == 90 ? "E" : tick == 180 ? "S" : tick == 270 ? "W" : String(tick)
+                            context.draw(Text(label).font(.caption).foregroundStyle(.secondary),
+                                         at: point(center, radius: radius - 28, angle: radians))
+                        }
+                    }
+                }
+                .accessibilityHidden(true)
+                RoundedRectangle(cornerRadius: 1)
+                    .fill(RouteAmendmentPanelStyle.reference)
+                    .frame(width: 3, height: 26)
+                    .offset(y: center.y - radius - 12)
+                    .accessibilityHidden(true)
+                VStack(spacing: 8) {
+                    Text(heading.map { String(format: "%03d°", $0) } ?? "Not set")
+                        .font(.largeTitle.weight(.semibold)).monospacedDigit()
+                    Text("MAGNETIC").font(.caption2).foregroundStyle(.secondary)
+                    if !dynamicTypeSize.isAccessibilitySize {
+                        Text("Flick for speed · drag slowly for 1°")
+                            .font(.caption2).foregroundStyle(.secondary)
+                    }
+                }
+                .padding(.top, dynamicTypeSize.isAccessibilitySize ? 0 : height * 0.36)
+                .accessibilityHidden(true)
+            }
+            .contentShape(interactionBand(center: center, radius: radius))
+            .clipped()
+            .gesture(drag(center: center, radius: radius))
+        }
+        // Keep the enlarged upright value above the arc rather than letting
+        // scaled height push its labels into the readout at accessibility sizes.
+        .frame(height: dynamicTypeSize.isAccessibilitySize ? 360 : compassHeight)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Magnetic heading")
+        .accessibilityValue(heading.map { String(format: "%03d degrees", $0) } ?? "Not set")
+        .accessibilityHint("Adjust by one degree. Clear is a separate action.")
+        .accessibilityAdjustableAction { direction in
+            stop()
+            switch direction {
+            case .increment: onSelection(heading.map { $0 == 360 ? 1 : $0 + 1 } ?? 1)
+            case .decrement: onSelection(heading.map { $0 == 1 ? 360 : $0 - 1 } ?? 360)
+            @unknown default: break
+            }
+        }
+        .accessibilityIdentifier("amendment-field-heading")
+        .onChange(of: heading) { _, value in if value == nil { stop() } }
+        .onChange(of: reduceMotion) { _, _ in stop() }
+        .onDisappear(perform: stop)
+    }
+
+    private func point(_ center: CGPoint, radius: CGFloat, angle: Double) -> CGPoint {
+        CGPoint(x: center.x + sin(angle) * radius, y: center.y - cos(angle) * radius)
+    }
+
+    /// Restrict angular input to the visible card. The upright value and space
+    /// around the arc remain available to the containing editor's scroll view.
+    private func interactionBand(center: CGPoint, radius: CGFloat) -> Path {
+        Path { path in
+            for degree in stride(from: -90.0, through: 90, by: 3) {
+                let location = point(center, radius: radius, angle: degree * .pi / 180)
+                if degree == -90 { path.move(to: location) } else { path.addLine(to: location) }
+            }
+            for degree in stride(from: 90.0, through: -90, by: -3) {
+                path.addLine(to: point(center, radius: max(0, radius - 44), angle: degree * .pi / 180))
+            }
+            path.closeSubpath()
+        }
+    }
+
+    private func angle(_ location: CGPoint, center: CGPoint) -> Double {
+        atan2(location.x - center.x, center.y - location.y) * 180 / .pi
+    }
+
+    private func drag(center: CGPoint, radius: CGFloat) -> some Gesture {
+        DragGesture(minimumDistance: 0)
+            .onChanged { value in
+                if !isDragging {
+                    stop()
+                    motion.begin(angle: angle(value.startLocation, center: center), heading: heading)
+                    isDragging = true
+                }
+                // The upright value's center is not a useful angular lever.
+                guard hypot(value.location.x - center.x, value.location.y - center.y) > radius * 0.3 else { return }
+                if let selected = motion.move(angle: angle(value.location, center: center)), selected != heading {
+                    onSelection(selected)
+                }
+            }
+            .onEnded { value in
+                isDragging = false
+                let radians = angle(value.location, center: center) * .pi / 180
+                let tangentVelocity = value.velocity.width * cos(radians) + value.velocity.height * sin(radians)
+                let velocity = -tangentVelocity / max(radius, 1) * 180 / .pi
+                let travel = RouteAmendmentHeadingMotion.coastTravel(velocity: velocity, reduceMotion: reduceMotion)
+                guard travel != 0, heading != nil else { return }
+                let start = motion.degrees
+                isCoasting = true
+                coast = Task { @MainActor in
+                    let clock = ContinuousClock()
+                    let began = clock.now
+                    var lastSelection = motion.heading
+                    while !Task.isCancelled {
+                        do { try await Task.sleep(for: .milliseconds(16)) } catch { return }
+                        guard !Task.isCancelled else { return }
+                        let elapsed = began.duration(to: clock.now)
+                        let seconds = Double(elapsed.components.seconds) + Double(elapsed.components.attoseconds) / 1e18
+                        let progress = min(1, seconds / 0.35)
+                        motion.degrees = start + travel * (1 - pow(1 - progress, 3))
+                        if motion.heading != lastSelection {
+                            lastSelection = motion.heading
+                            onSelection(lastSelection)
+                        }
+                        if progress == 1 { break }
+                    }
+                    isCoasting = false
+                    coast = nil
+                }
+            }
+    }
+
+    private func stop() {
+        coast?.cancel()
+        coast = nil
+        isCoasting = false
+        isDragging = false
+    }
+}
diff --git a/NavigationFlight/Features/Cockpit/RouteAmendmentCyclicTimeWheel.swift b/NavigationFlight/Features/Cockpit/RouteAmendmentCyclicTimeWheel.swift
new file mode 100644
index 0000000..454f420
--- /dev/null
+++ b/NavigationFlight/Features/Cockpit/RouteAmendmentCyclicTimeWheel.swift
@@ -0,0 +1,87 @@
+import SwiftUI
+import UIKit
+
+/// Native picker mechanics with distinct physical rows for repeated logical values.
+/// Recenter only after selection settles; recentering never emits a draft intent.
+struct RouteAmendmentCyclicTimeWheel: UIViewRepresentable {
+    let selection: Int?
+    let component: RouteAmendmentLegEntry.TimeComponent
+    let onStep: (Int) -> Void
+
+    func makeCoordinator() -> Coordinator { Coordinator(self) }
+
+    func makeUIView(context: Context) -> UIPickerView {
+        let picker = UIPickerView()
+        picker.dataSource = context.coordinator
+        picker.delegate = context.coordinator
+        picker.accessibilityIdentifier = "amendment-field-\(component.rawValue)"
+        picker.accessibilityLabel = "Leg time \(component.rawValue)"
+        context.coordinator.synchronize(picker, selection: selection)
+        return picker
+    }
+
+    func sizeThatFits(_ proposal: ProposedViewSize, uiView: UIPickerView, context: Context) -> CGSize? {
+        CGSize(width: proposal.width ?? 110, height: proposal.height ?? 108)
+    }
+
+    func updateUIView(_ picker: UIPickerView, context: Context) {
+        context.coordinator.parent = self
+        if context.coordinator.selection != selection {
+            context.coordinator.synchronize(picker, selection: selection)
+        }
+    }
+
+    static func dismantleUIView(_ picker: UIPickerView, coordinator: Coordinator) {
+        picker.delegate = nil
+        picker.dataSource = nil
+    }
+
+    final class Coordinator: NSObject, UIPickerViewDataSource, UIPickerViewDelegate {
+        var parent: RouteAmendmentCyclicTimeWheel
+        var selection: Int?
+        private var selectedRow = 3000
+        private var specialRow = 3000
+
+        init(_ parent: RouteAmendmentCyclicTimeWheel) { self.parent = parent }
+
+        func synchronize(_ picker: UIPickerView, selection: Int?) {
+            self.selection = selection
+            selectedRow = 3000 + (selection ?? 0) % 60
+            specialRow = selectedRow
+            picker.reloadAllComponents()
+            picker.selectRow(selectedRow, inComponent: 0, animated: false)
+        }
+
+        func numberOfComponents(in pickerView: UIPickerView) -> Int { 1 }
+        func pickerView(_ pickerView: UIPickerView, numberOfRowsInComponent component: Int) -> Int { 6001 }
+        func pickerView(_ pickerView: UIPickerView, rowHeightForComponent component: Int) -> CGFloat {
+            max(32, UIFont.preferredFont(forTextStyle: .title3).lineHeight + 8)
+        }
+
+        func pickerView(_ pickerView: UIPickerView, viewForRow row: Int, forComponent component: Int,
+                        reusing view: UIView?) -> UIView {
+            let label = (view as? UILabel) ?? UILabel()
+            let value = (selection == nil && row > specialRow ? row - 1 : row) % 60
+            let displayed = row == specialRow ? selection : value
+            label.text = displayed.map { String(format: "%02d", $0) } ?? "Not set"
+            label.font = .preferredFont(forTextStyle: .title3)
+            label.adjustsFontForContentSizeCategory = true
+            label.textAlignment = .center
+            label.textColor = .label
+            label.accessibilityLabel = displayed.map { "Leg time \(parent.component.rawValue), \($0) \(parent.component.rawValue)" }
+                ?? "Leg time \(parent.component.rawValue), Not set"
+            return label
+        }
+
+        func pickerView(_ pickerView: UIPickerView, didSelectRow row: Int, inComponent component: Int) {
+            let steps = row - selectedRow
+            guard steps != 0 else { return }
+            // Update the cached selection before emitting; SwiftUI may immediately
+            // synchronize the carried component in the other wheel.
+            let delta = selection == nil && steps > 0 ? steps - 1 : steps
+            let next = (((selection ?? 0) % 60 + delta % 60) % 60 + 60) % 60
+            synchronize(pickerView, selection: next)
+            parent.onStep(steps)
+        }
+    }
+}
diff --git a/NavigationFlight/Features/Cockpit/RouteAmendmentHeadingMotion.swift b/NavigationFlight/Features/Cockpit/RouteAmendmentHeadingMotion.swift
new file mode 100644
index 0000000..cda37be
--- /dev/null
+++ b/NavigationFlight/Features/Cockpit/RouteAmendmentHeadingMotion.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+/// Unwrapped presentation angle; only `heading` crosses the domain boundary.
+nonisolated struct RouteAmendmentHeadingMotion {
+    var degrees: Double = 360
+    private var previousAngle: Double?
+    private var origin: Double = 360
+    private var hasMoved = false
+
+    var heading: Int {
+        let value = ((Int(degrees.rounded()) % 360) + 360) % 360
+        return value == 0 ? 360 : value
+    }
+
+    mutating func begin(angle: Double, heading: Int?) {
+        degrees = heading.map(Double.init) ?? 360
+        origin = degrees
+        hasMoved = false
+        previousAngle = angle
+    }
+
+    mutating func move(angle: Double) -> Int? {
+        guard let previousAngle else { return nil }
+        var delta = (angle - previousAngle).truncatingRemainder(dividingBy: 360)
+        if delta > 180 { delta -= 360 }
+        if delta < -180 { delta += 360 }
+        degrees -= delta
+        self.previousAngle = angle
+        hasMoved = hasMoved || abs(degrees - origin) >= 0.5
+        return hasMoved ? heading : nil
+    }
+
+    static func coastTravel(velocity: Double, reduceMotion: Bool) -> Double {
+        guard !reduceMotion, abs(velocity) >= 90 else { return 0 }
+        return min(90, max(-90, velocity * 0.15))
+    }
+}
